# ── Base de datos ──────────────────────────────────────────────────────────────
# URL de conexión Prisma para la BD principal
DATABASE_URL="mysql://root:secret@localhost:3306/antojo"

# URL de conexión Prisma para la BD de tests (mismo contenedor, schema distinto)
DATABASE_URL_TEST="mysql://root:secret@localhost:3306/antojo_test"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Clave secreta para firmar access tokens (mínimo 32 caracteres)
JWT_SECRET="cambia_esto_en_produccion_min32chars"

# Clave secreta para firmar refresh tokens (distinta del access)
JWT_REFRESH_SECRET="cambia_esto_en_produccion_refresh_min32"

# Tiempo de expiración del access token (ej. 15m, 1h)
JWT_ACCESS_EXPIRES="15m"

# Tiempo de expiración del refresh token (ej. 7d, 30d)
JWT_REFRESH_EXPIRES="7d"

# ── Asistente IA ───────────────────────────────────────────────────────────────
# API key de Groq para el modelo llama-3.3-70b-versatile.
# NOTA (decisión 13): si esta variable está ausente o es inválida, el asistente
# Yanet falla de forma controlada con un mensaje amigable; el servidor NO crashea.
GROQ_API_KEY="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"

# ── Servidor API ───────────────────────────────────────────────────────────────
# Puerto en que escucha la API Express
PORT=4000

# Origen(es) permitidos por CORS (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173"

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# URL base de la API GraphQL (consumida por Apollo Client en el frontend)
VITE_API_URL="http://localhost:4000/graphql"

# URL del servidor WebSocket (Socket.IO)
VITE_WS_URL="http://localhost:4000"

# ── Web Push ──────────────────────────────────────────────────────────────────
# Clave pública VAPID (se entrega al navegador para suscribir notificaciones push)
VITE_VAPID_PUBLIC_KEY="BIdZxDSeSiI5MeQvslkghIsz6rd1N044Kz65huvmdWghXljYboBwp0cqG7jVae292h1AYGIQQh59bX8XqyOdOcs"

# ── MySQL (Docker Compose) ─────────────────────────────────────────────────────
# Contraseña del usuario root de MySQL en el contenedor
MYSQL_ROOT_PASSWORD="secret"

# Nombre del schema principal (se crea automáticamente en el init SQL)
MYSQL_DATABASE="antojo"
