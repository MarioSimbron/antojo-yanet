# ── Base de datos ──────────────────────────────────────────────────────────────
# URL de conexión Prisma para la BD principal (PostgreSQL; en producción es Neon).
# Dentro de Docker Compose se sobrescribe para apuntar al servicio "postgres".
DATABASE_URL="postgresql://postgres:secret@localhost:5432/antojo"

# URL de conexión Prisma para la BD de tests (mismo contenedor, base distinta)
DATABASE_URL_TEST="postgresql://postgres:secret@localhost:5432/antojo_test"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Clave secreta para firmar access tokens (mínimo 32 caracteres)
JWT_SECRET="cambia_esto_en_produccion_min32chars"

# Clave secreta para firmar refresh tokens (distinta del access)
JWT_REFRESH_SECRET="cambia_esto_en_produccion_refresh_min32"

# Tiempo de expiración del access token (ej. 15m, 1h)
JWT_ACCESS_EXPIRES="15m"

# Tiempo de expiración del refresh token (ej. 7d, 30d)
JWT_REFRESH_EXPIRES="7d"

# ── Asistente IA ───────────────────────────────────────────────────────────────
# API key de Groq (https://console.groq.com/keys).
# NOTA (decisión 13): si esta variable está ausente o es inválida, el asistente
# Yanet falla de forma controlada con un mensaje amigable; el servidor NO crashea.
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Modelo de Groq (debe soportar tool calling). Opcional; por defecto openai/gpt-oss-20b,
# el mismo que usa producción. El plan gratuito de Groq ya no incluye modelos Llama
# conversacionales. Groq retira modelos con el tiempo: consulta los disponibles en
# https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-20b"

# Desactiva el modelo de embeddings ONNX (consume bastante RAM) y usa scoring por palabras
# clave en el RAG. Útil en hosts con poca memoria (plan gratuito de Render).
# DISABLE_EMBEDDINGS="true"

# ── Servidor API ───────────────────────────────────────────────────────────────
# Puerto en que escucha la API Express
PORT=4000

# Origen(es) permitidos por CORS (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173"

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# URL base de la API GraphQL (consumida por Apollo Client en el frontend)
VITE_API_URL="http://localhost:4000/graphql"

# URL del servidor WebSocket (Socket.IO)
VITE_WS_URL="http://localhost:4000"

# ── PostgreSQL (Docker Compose) ────────────────────────────────────────────────
# Contraseña del usuario postgres en el contenedor. Las bases antojo y antojo_test
# se crean automáticamente al inicializar el volumen.
POSTGRES_PASSWORD="secret"
