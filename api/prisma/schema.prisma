generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  MAESTRO_PANADERO
  CAJERO
  REPARTIDOR
  CLIENTE
}

enum EstatusPedido {
  PENDIENTE
  ESPERANDO_CONFIRMACION
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  SOLICITUD_CANCELACION
  CANCELADO
}

enum TipoEntrega {
  MOSTRADOR
  DOMICILIO
}

enum FormaPago {
  EFECTIVO
  TARJETA
}

enum EstatusTarea {
  PROPUESTA
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
  RECHAZADA
}

enum PrioridadCompra {
  ALTA
  MEDIA
  BAJA
}

enum EstatusCompra {
  PENDIENTE
  EN_PROCESO
  SURTIDO
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  telefono      String?
  rol           Rol      @default(CLIENTE)
  puntosSaldo   Int      @default(0) @map("puntos_saldo")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pedidos                 Pedido[]                  @relation("UsuarioPedidos")
  pedidosRepartidos       Pedido[]                  @relation("RepartidorPedidos")
  historialAcciones       HistorialEstatusPedido[]
  tareasAsignadas         TareaProduccion[]         @relation("TareasAsignadas")
  pushSubscriptions       PushSubscription[]
  notificaciones          Notificacion[]
  listaCompras            ListaCompra[]

  @@map("usuario")
}

model Producto {
  id               Int       @id @default(autoincrement())
  sku              String    @unique
  nombre           String
  descripcion      String?   @db.Text
  precio           Decimal   @db.Decimal(10, 2)
  categoria        String
  imagenUrl        String?   @map("imagen_url")
  activo           Boolean   @default(true)
  stockDisponible  Int       @default(0) @map("stock_disponible")
  requiereEncargo  Boolean   @default(false) @map("requiere_encargo")
  temporadaInicio  DateTime? @map("temporada_inicio")
  temporadaFin     DateTime? @map("temporada_fin")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  itemsPedido      ItemPedido[]
  tareasProduccion TareaProduccion[]
  recetaItems      RecetaItem[]

  @@map("producto")
}

model Pedido {
  id                    Int           @id @default(autoincrement())
  usuarioId             Int?          @map("usuario_id")
  guestToken            String?       @map("guest_token") @db.VarChar(36)
  nombreCliente         String        @map("nombre_cliente")
  email                 String
  telefono              String
  tipoEntrega           TipoEntrega   @map("tipo_entrega")
  direccion             String?       @db.Text
  formaPago             FormaPago     @map("forma_pago")
  estatus               EstatusPedido @default(PENDIENTE)
  subtotal              Decimal       @db.Decimal(10, 2)
  costoEnvio            Decimal       @default(0) @map("costo_envio") @db.Decimal(10, 2)
  descuentoPuntos       Decimal       @default(0) @map("descuento_puntos") @db.Decimal(10, 2)
  montoDeposito         Decimal       @default(0) @map("monto_deposito") @db.Decimal(10, 2)
  porcentajeDeposito    Decimal       @default(0) @map("porcentaje_deposito") @db.Decimal(5, 2)
  total                 Decimal       @db.Decimal(10, 2)
  fechaEntregaEstimada  DateTime?     @map("fecha_entrega_estimada")
  repartidorId          Int?          @map("repartidor_id")
  tiempoEstimadoMinutos Int?          @map("tiempo_estimado_minutos")
  cancelacionMotivo     String?       @map("cancelacion_motivo") @db.Text
  notasEncargo          String?       @map("notas_encargo") @db.Text
  imagenRefUrl          String?       @map("imagen_ref_url") @db.LongText
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  usuario    Usuario? @relation("UsuarioPedidos", fields: [usuarioId], references: [id])
  repartidor Usuario? @relation("RepartidorPedidos", fields: [repartidorId], references: [id])

  items     ItemPedido[]
  historial HistorialEstatusPedido[]
  factura   FacturaCFDI?

  @@index([guestToken])
  @@index([usuarioId])
  @@map("pedido")
}

model ItemPedido {
  id                   Int     @id @default(autoincrement())
  pedidoId             Int     @map("pedido_id")
  productoId           Int     @map("producto_id")
  cantidad             Int
  precioUnitario       Decimal @map("precio_unitario") @db.Decimal(10, 2)
  esEncargo            Boolean @map("es_encargo")
  mensajePersonalizado String? @map("mensaje_personalizado") @db.Text

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("item_pedido")
}

model HistorialEstatusPedido {
  id        Int           @id @default(autoincrement())
  pedidoId  Int           @map("pedido_id")
  estatus   EstatusPedido
  timestamp DateTime      @default(now())
  actorId   Int?          @map("actor_id")
  nota      String?       @db.Text

  pedido Pedido   @relation(fields: [pedidoId], references: [id])
  actor  Usuario? @relation(fields: [actorId], references: [id])

  @@map("historial_estatus_pedido")
}

model FacturaCFDI {
  id          Int    @id @default(autoincrement())
  pedidoId    Int    @unique @map("pedido_id")
  rfc         String @db.VarChar(13)
  razonSocial String @map("razon_social")
  usoCFDI     String @map("uso_cfdi") @db.VarChar(10)

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("factura_cfdi")
}

model TareaProduccion {
  id                 Int          @id @default(autoincrement())
  productoId         Int          @map("producto_id")
  cantidadSolicitada Int          @map("cantidad_solicitada")
  cantidadProducida  Int?         @map("cantidad_producida")
  estatus            EstatusTarea @default(PENDIENTE)
  notas              String?      @db.Text
  asignadoPorId      Int          @map("asignado_por_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  producto    Producto @relation(fields: [productoId], references: [id])
  asignadoPor Usuario  @relation("TareasAsignadas", fields: [asignadoPorId], references: [id])

  @@map("tarea_produccion")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("push_subscription")
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  guestToken String?  @map("guest_token") @db.VarChar(36)
  titulo     String
  cuerpo     String   @db.Text
  url        String?  @db.VarChar(500)
  leida      Boolean  @default(false)
  creadaEn   DateTime @default(now()) @map("creada_en")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([guestToken])
  @@map("notificacion")
}

model Cupon {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique @db.VarChar(20)
  usuarioId        Int?     @map("usuario_id")
  montoOriginal    Decimal  @map("monto_original") @db.Decimal(10, 2)
  saldoDisponible  Decimal  @map("saldo_disponible") @db.Decimal(10, 2)
  fechaExpiracion  DateTime @map("fecha_expiracion")
  usado            Boolean  @default(false)

  @@map("cupon")
}

model Insumo {
  id          Int      @id @default(autoincrement())
  nombre      String
  unidad      String   @db.VarChar(30)
  stockActual Decimal  @default(0) @map("stock_actual") @db.Decimal(10, 3)
  stockMinimo Decimal  @default(0) @map("stock_minimo") @db.Decimal(10, 3)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recetaItems  RecetaItem[]
  listaCompras ListaCompra[]

  @@map("insumo")
}

model RecetaItem {
  id                Int     @id @default(autoincrement())
  productoId        Int     @map("producto_id")
  insumoId          Int     @map("insumo_id")
  cantidadPorUnidad Decimal @map("cantidad_por_unidad") @db.Decimal(10, 3)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  insumo   Insumo   @relation(fields: [insumoId],   references: [id], onDelete: Cascade)

  @@unique([productoId, insumoId])
  @@map("receta_item")
}

model ListaCompra {
  id          Int             @id @default(autoincrement())
  nombre      String
  cantidad    Decimal         @db.Decimal(10, 3)
  unidad      String          @db.VarChar(30)
  prioridad   PrioridadCompra @default(MEDIA)
  notas       String?         @db.Text
  estatus     EstatusCompra   @default(PENDIENTE)
  creadoPorId Int             @map("creado_por_id")
  insumoId    Int?            @map("insumo_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt      @map("updated_at")

  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])
  insumo    Insumo?  @relation(fields: [insumoId],    references: [id])

  @@index([creadoPorId])
  @@map("lista_compra")
}
